const TEX_SIZE = 64;
const wallTextureCanvas = document.createElement('canvas');
wallTextureCanvas.width = TEX_SIZE;
wallTextureCanvas.height = TEX_SIZE;
const tCtx = wallTextureCanvas.getContext('2d');

function updateWallTexture(theme) {
  tCtx.fillStyle = theme.wallBase;
  tCtx.fillRect(0, 0, TEX_SIZE, TEX_SIZE);

  const rows = 4;
  const rowHeight = TEX_SIZE / rows;
  for (let r = 0; r < rows; r++) {
    const y = r * rowHeight;
    const cols = 2;
    const colWidth = TEX_SIZE / cols;
    const offset = (r % 2) * (colWidth / 2);

    for (let c = -1; c <= cols; c++) {
      const x = c * colWidth + offset;
      const [cr, cg, cb] = theme.brickCol;
      const variation = Math.floor(Math.sin(r * 3 + c * 7) * 15);
      tCtx.fillStyle = `rgb(${Math.min(255, Math.max(0, cr + variation))}, ${Math.min(255, Math.max(0, cg + variation))}, ${Math.min(255, Math.max(0, cb + variation))})`;
      tCtx.fillRect(x + 2, y + 2, colWidth - 4, rowHeight - 4);

      tCtx.fillStyle = 'rgba(0,0,0,0.4)';
      tCtx.fillRect(x + 5, y + 5, colWidth - 10, 1);
      
      tCtx.strokeStyle = 'rgba(0,0,0,0.6)';
      tCtx.lineWidth = 1.5;
      tCtx.strokeRect(x, y, colWidth, rowHeight);
    }
  }
}

