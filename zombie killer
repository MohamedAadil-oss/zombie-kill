function exitGame() {
  if (document.exitPointerLock) document.exitPointerLock();
  gameState = 'menu';
  document.getElementById('device-select-screen').style.display = 'none';
  document.getElementById('game-over-screen').style.display = 'none';
  document.getElementById('level-clear-screen').style.display = 'none';
  document.getElementById('victory-screen').style.display = 'none';
  document.getElementById('char-select-screen').style.display = 'flex';
  document.getElementById('arrow-selector').style.display = 'none';
  document.getElementById('buff-box').innerHTML = '';
  document.getElementById('mobile-ui').style.display = 'none';
  document.getElementById('exit-btn').style.display = 'none';
  document.getElementById('boss-hud').style.display = 'none';
}

function resetToMenu() {
  exitGame();
}

// Single Press / Click Attack Trigger Logic
canvas.addEventListener('click', () => {
  if (gameState === 'playing' && deviceMode === 'desktop') canvas.requestPointerLock();
});

document.addEventListener('mousemove', e => {
  if (document.pointerLockElement === canvas && gameState === 'playing') {
    player.angle += e.movementX * 0.0032;
  }
});

// Single attack per click on Desktop
window.addEventListener('mousedown', (e) => {
  if (deviceMode === 'desktop' && gameState === 'playing' && e.button === 0) {
    if (player) player.triggerAttack();
  }
});

window.addEventListener('keydown', e => {
  keys[e.key.toLowerCase()] = true;
  if (chosenClass === 'archer') {
    if (e.key === '1') setArrowType('normal');
    if (e.key === '2') setArrowType('fire');
    if (e.key === '3') setArrowType('ice');
  }
});
window.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });

const joyBase = document.getElementById('joystick-base');
const joyStick = document.getElementById('joystick-stick');
const touchLookZone = document.getElementById('touch-look-zone');
const attackBtn = document.getElementById('mobile-attack-btn');

// Single attack per tap on Mobile
attackBtn.addEventListener('touchstart', (e) => {
  e.preventDefault();
  if (gameState === 'playing' && player) {
    player.triggerAttack();
  }
});

joyBase.addEventListener('touchstart', (e) => {
  e.preventDefault();
  const touch = e.changedTouches[0];
  joystick.active = true;
  joystick.touchId = touch.identifier;
  const rect = joyBase.getBoundingClientRect();
  joystick.startX = rect.left + rect.width / 2;
  joystick.startY = rect.top + rect.height / 2;
});

window.addEventListener('touchmove', (e) => {
  for (let i = 0; i < e.touches.length; i++) {
    const touch = e.touches[i];
    if (joystick.active && touch.identifier === joystick.touchId) {
      let dx = touch.clientX - joystick.startX;
      let dy = touch.clientY - joystick.startY;
      const maxDist = 38;
      const dist = Math.hypot(dx, dy);
      if (dist > maxDist) {
        dx = (dx / dist) * maxDist;
        dy = (dy / dist) * maxDist;
      }
      joystick.dx = dx / maxDist;
      joystick.dy = dy / maxDist;
      joyStick.style.transform = `translate(${dx}px, ${dy}px)`;
    } else if (touchLook.active && touch.identifier === touchLook.touchId) {
      const deltaX = touch.clientX - touchLook.lastX;
      player.angle += deltaX * 0.007;
      touchLook.lastX = touch.clientX;
    }
  }
});

window.addEventListener('touchend', (e) => {
  for (let i = 0; i < e.changedTouches.length; i++) {
    const touch = e.changedTouches[i];
    if (touch.identifier === joystick.touchId) {
      joystick.active = false;
      joystick.dx = 0;
      joystick.dy = 0;
      joyStick.style.transform = `translate(0px, 0px)`;
    }
    if (touch.identifier === touchLook.touchId) {
      touchLook.active = false;
    }
  }
});

touchLookZone.addEventListener('touchstart', (e) => {
  e.preventDefault();
  const touch = e.changedTouches[0];
  touchLook.active = true;
  touchLook.touchId = touch.identifier;
  touchLook.lastX = touch.clientX;
});

let player;
let projectiles = [];
let enemyProjectiles = [];
let zombies = [];
let drops = [];
let spawnTimer = 0;
let zBuffer = new Array(canvas.width).fill(0);

class PlayerFPS {
  constructor(heroClass) {
    this.x = 8.0;
    this.y = 8.0;
    this.angle = 0;
    this.heroClass = heroClass;
    this.baseSpeed = 0.065;
    this.attackCooldown = 0;
    this.swingAnim = 0;
    this.buffTimer = 0;
    this.speedTimer = 0;
    this.shieldTimer = 0;
    this.freezeTimer = 0;
    this.bobTimer = 0;

    if (heroClass === 'warrior') {
      this.maxHp = 350; this.hp = 350;
      this.maxMp = 0; this.mp = 0;
    } else if (heroClass === 'wizard') {
      this.maxHp = 150; this.hp = 150;
      this.maxMp = 200; this.mp = 200;
    } else if (heroClass === 'archer') {
      this.maxHp = 200; this.hp = 200;
      this.maxMp = 0; this.mp = 0;
    }
  }

  update() {
    const hpRatio = Math.max(0.05, this.hp / this.maxHp);
    let speedMult = this.speedTimer > 0 ? 1.5 : 1.0;
    if (this.freezeTimer > 0) { speedMult *= 0.35; this.freezeTimer--; }
    const currentSpeed = this.baseSpeed * (0.55 + 0.45 * hpRatio) * speedMult;

    const injuryEl = document.getElementById('injury-status');
    if (hpRatio < 0.5 && this.speedTimer <= 0) {
      injuryEl.style.display = 'block';
      injuryEl.innerText = `⚠️ INJURED: ${Math.round((0.55 + 0.45 * hpRatio) * 100)}% Speed`;
    } else {
      injuryEl.style.display = 'none';
    }

    let dx = 0, dy = 0;
    const cos = Math.cos(this.angle);
    const sin = Math.sin(this.angle);

    let isMoving = false;
    if (keys['w'] || keys['arrowup']) { dx += cos * currentSpeed; dy += sin * currentSpeed; isMoving = true; }
    if (keys['s'] || keys['arrowdown']) { dx -= cos * currentSpeed; dy -= sin * currentSpeed; isMoving = true; }
    if (keys['a']) { dx += sin * currentSpeed; dy -= cos * currentSpeed; isMoving = true; }
    if (keys['d']) { dx -= sin * currentSpeed; dy += cos * currentSpeed; isMoving = true; }
    if (keys['arrowleft']) this.angle -= 0.04;
    if (keys['arrowright']) this.angle += 0.04;

    if (joystick.active) {
      const joyForward = -joystick.dy;
      const joyStrafe = joystick.dx;
      dx += (cos * joyForward - sin * joyStrafe) * currentSpeed;
      dy += (sin * joyForward + cos * joyStrafe) * currentSpeed;
      if (Math.hypot(joystick.dx, joystick.dy) > 0.1) isMoving = true;
    }

    if (isMoving) this.bobTimer += 0.18;
    else this.bobTimer += 0.04;

    if (MAP[Math.floor(this.y)][Math.floor(this.x + dx * 1.5)] === 0) this.x += dx;
    if (MAP[Math.floor(this.y + dy * 1.5)][Math.floor(this.x)] === 0) this.y += dy;

    if (this.buffTimer > 0) this.buffTimer--;
    if (this.speedTimer > 0) this.speedTimer--;
    if (this.shieldTimer > 0) this.shieldTimer--;

    const buffBox = document.getElementById('buff-box');
    let buffHTML = '';
    if (this.buffTimer > 0) buffHTML += `<div class="buff-item" style="border-color:#ffd166; color:#ffd166;">⚡ WEAPON BUFF: ${(this.buffTimer/60).toFixed(1)}s</div>`;
    if (this.speedTimer > 0) buffHTML += `<div class="buff-item" style="border-color:#52b788; color:#52b788;">🪶 SPEED BOOST: ${(this.speedTimer/60).toFixed(1)}s</div>`;
    if (this.shieldTimer > 0) buffHTML += `<div class="buff-item" style="border-color:#48cae4; color:#48cae4;">🛡️ INVULNERABLE: ${(this.shieldTimer/60).toFixed(1)}s</div>`;
    buffBox.innerHTML = buffHTML;

    if (this.heroClass === 'wizard' && this.mp < this.maxMp) {
      const regen = (this.buffTimer > 0) ? 0.8 : 0.4;
      this.mp = Math.min(this.maxMp, this.mp + regen);
    }

    if (this.attackCooldown > 0) this.attackCooldown--;
    if (this.swingAnim > 0) this.swingAnim -= 0.12;
  }

  // Single-execution attack routine called once per tap/click
  triggerAttack() {
    if (this.attackCooldown > 0) return;

    const isBuffed = this.buffTimer > 0;
    this.swingAnim = 1.0;

    if (this.heroClass === 'warrior') {
      this.attackCooldown = 18;
      const reach = isBuffed ? 4.5 : 1.6;
      const damage = isBuffed ? 75 : 45;

      zombies.forEach(z => {
        const dx = z.x - this.x;
        const dy = z.y - this.y;
        const dist = Math.hypot(dx, dy);
        if (dist <= reach) {
          let enemyAngle = Math.atan2(dy, dx) - this.angle;
          while (enemyAngle < -Math.PI) enemyAngle += Math.PI * 2;
          while (enemyAngle > Math.PI) enemyAngle -= Math.PI * 2;
          if (Math.abs(enemyAngle) < 0.45) {
            z.hp -= damage;
            z.x += Math.cos(this.angle) * 0.4;
            z.y += Math.sin(this.angle) * 0.4;
          }
        }
      });
    } else if (this.heroClass === 'wizard') {
      const manaCost = 25;
      if (this.mp >= manaCost) {
        this.mp -= manaCost;
        this.attackCooldown = isBuffed ? 12 : 18;
        let projType = isBuffed ? 'bigMagic' : 'magic';
        let color = isBuffed ? '#ff0054' : '#c77dff';
        let damage = isBuffed ? 70 : 40;
        let speed = 0.22;
        projectiles.push(new ProjectileFPS(this.x, this.y, this.angle, speed, damage, projType, color, false));
      }
    } else if (this.heroClass === 'archer') {
      this.attackCooldown = 15;
      let color = '#f4a261';
      let damage = 25;
      if (arrowType === 'fire') { color = '#e76f51'; damage = 30; }
      if (arrowType === 'ice') { color = '#48cae4'; damage = 20; }

      if (isBuffed) {
        projectiles.push(new ProjectileFPS(this.x, this.y, this.angle - 0.12, 0.28, damage, arrowType, color, false));
        projectiles.push(new ProjectileFPS(this.x, this.y, this.angle, 0.28, damage, arrowType, color, false));
        projectiles.push(new ProjectileFPS(this.x, this.y, this.angle + 0.12, 0.28, damage, arrowType, color, false));
      } else {
        projectiles.push(new ProjectileFPS(this.x, this.y, this.angle, 0.28, damage, arrowType, color, false));
      }
    }
  }
}

class ProjectileFPS {
  constructor(x, y, angle, speed, damage, type, color, isHostile = false) {
    this.x = x;
    this.y = y;
    this.vx = Math.cos(angle) * speed;
    this.vy = Math.sin(angle) * speed;
    this.damage = damage;
    this.type = type;
    this.color = color;
    this.isHostile = isHostile;
    this.dead = false;
  }
  update() {
    this.x += this.vx;
    this.y += this.vy;
    if (MAP[Math.floor(this.y)] && MAP[Math.floor(this.y)][Math.floor(this.x)] === 1) {
      this.dead = true;
    }
    if (this.isHostile && Math.hypot(player.x - this.x, player.y - this.y) < 0.6) {
      if (player.shieldTimer <= 0) {
        player.hp -= this.damage;
        if (this.type === 'frost') player.freezeTimer = 90;
      }
      this.dead = true;
    }
  }
}

class DropFPS {
  constructor(x, y, dropType, heroClass) {
    this.x = x;
    this.y = y;
    this.dropType = dropType;
    this.heroClass = heroClass;
    this.life = 450;
    this.bobOffset = Math.random() * 10;
  }

  update() {
    this.life--;
    const dist = Math.hypot(player.x - this.x, player.y - this.y);
    if (dist < 0.8) {
      if (this.dropType === 'buff') {
        player.buffTimer = 300;
      } else if (this.dropType === 'health') {
        player.hp = Math.min(player.maxHp, player.hp + 60);
      } else if (this.dropType === 'mana') {
        player.mp = Math.min(player.maxMp, player.mp + 80);
      } else if (this.dropType === 'speed') {
        player.speedTimer = 360;
      } else if (this.dropType === 'shield') {
        player.shieldTimer = 300;
      } else if (this.dropType === 'freeze') {
        zombies.forEach(z => { z.slowTimer = 240; });
      } else if (this.dropType === 'nuke') {
        zombies.forEach(z => {
          if (!z.isBoss) z.hp = 0;
          else z.hp -= 200;
        });
      }
      this.life = 0;
    }
  }

  drawGraphic(screenX, screenY, size, dist) {
    ctx.save();
    const time = Date.now() / 150 + this.bobOffset;
    const hoverY = screenY + Math.sin(time) * 8;
    const r = Math.max(6, size * 0.45);

    if (this.dropType === 'health') {
      const glow = ctx.createRadialGradient(screenX, hoverY, r * 0.2, screenX, hoverY, r * 2.2);
      glow.addColorStop(0, 'rgba(230, 57, 70, 0.85)');
      glow.addColorStop(1, 'rgba(230, 57, 70, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r * 2.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ff4d6d';
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.fillStyle = '#6c584c';
      ctx.fillRect(screenX - r * 0.3, hoverY - r * 1.3, r * 0.6, r * 0.35);

      ctx.fillStyle = '#fff';
      ctx.fillRect(screenX - 1.5, hoverY - r * 0.4, 3, r * 0.8);
      ctx.fillRect(screenX - r * 0.4, hoverY - 1.5, r * 0.8, 3);

    } else if (this.dropType === 'mana') {
      const glow = ctx.createRadialGradient(screenX, hoverY, r * 0.2, screenX, hoverY, r * 2.2);
      glow.addColorStop(0, 'rgba(69, 123, 157, 0.85)');
      glow.addColorStop(1, 'rgba(69, 123, 157, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r * 2.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#00b4d8';
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.fillStyle = '#fff';
      ctx.font = `bold ${Math.max(8, Math.floor(r * 1.1))}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('MP', screenX, hoverY);

    } else if (this.dropType === 'speed') {
      const glow = ctx.createRadialGradient(screenX, hoverY, r * 0.2, screenX, hoverY, r * 2.2);
      glow.addColorStop(0, 'rgba(82, 183, 136, 0.85)');
      glow.addColorStop(1, 'rgba(82, 183, 136, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r * 2.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#52b788';
      ctx.beginPath();
      ctx.ellipse(screenX, hoverY, r * 0.6, r * 1.2, 0.3, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.fillStyle = '#fff';
      ctx.font = `bold ${Math.max(8, Math.floor(r * 1.1))}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('🪶', screenX, hoverY);

    } else if (this.dropType === 'shield') {
      const glow = ctx.createRadialGradient(screenX, hoverY, r * 0.2, screenX, hoverY, r * 2.2);
      glow.addColorStop(0, 'rgba(72, 202, 228, 0.85)');
      glow.addColorStop(1, 'rgba(72, 202, 228, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r * 2.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#48cae4';
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.fillStyle = '#fff';
      ctx.font = `bold ${Math.max(8, Math.floor(r * 1.1))}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('🛡️', screenX, hoverY);

    } else if (this.dropType === 'freeze') {
      const glow = ctx.createRadialGradient(screenX, hoverY, r * 0.2, screenX, hoverY, r * 2.2);
      glow.addColorStop(0, 'rgba(202, 240, 248, 0.9)');
      glow.addColorStop(1, 'rgba(0, 119, 182, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r * 2.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#90e0ef';
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.fillStyle = '#03045e';
      ctx.font = `bold ${Math.max(8, Math.floor(r * 1.1))}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('❄️', screenX, hoverY);

    } else if (this.dropType === 'nuke') {
      const glow = ctx.createRadialGradient(screenX, hoverY, r * 0.2, screenX, hoverY, r * 2.2);
      glow.addColorStop(0, 'rgba(247, 127, 0, 0.9)');
      glow.addColorStop(1, 'rgba(214, 40, 40, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r * 2.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#d62828';
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#fcbf49';
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.fillStyle = '#fff';
      ctx.font = `bold ${Math.max(8, Math.floor(r * 1.1))}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('💣', screenX, hoverY);

    } else {
      const glow = ctx.createRadialGradient(screenX, hoverY, r * 0.3, screenX, hoverY, r * 2.5);
      glow.addColorStop(0, 'rgba(255, 209, 102, 0.9)');
      glow.addColorStop(1, 'rgba(255, 183, 3, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(screenX, hoverY, r * 2.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = '#ffd166';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.ellipse(screenX, hoverY, r * 1.5, r * 0.7, time * 0.5, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = '#ffb703';
      ctx.beginPath();
      ctx.moveTo(screenX, hoverY - r * 1.2);
      ctx.lineTo(screenX + r * 1.1, hoverY);
      ctx.lineTo(screenX, hoverY + r * 1.2);
      ctx.lineTo(screenX - r * 1.1, hoverY);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.fillStyle = '#111';
      ctx.font = `bold ${Math.max(8, Math.floor(r * 1.1))}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      const icon = this.heroClass === 'warrior' ? '🗡️' : (this.heroClass === 'wizard' ? '🪄' : '🏹');
      ctx.fillText(icon, screenX, hoverY);
    }

    ctx.restore();
  }
}

class ZombieFPS {
  constructor(type, levelIndex, isBoss = false) {
    this.type = type;
    this.levelIndex = levelIndex;
    this.isBoss = isBoss;

    let validSpawn = false;
    let attempts = 0;
    this.x = 2.5;
    this.y = 2.5;

    while (!validSpawn && attempts < 50) {
      attempts++;
      let rx = 1.5 + Math.random() * (MAP_SIZE - 3);
      let ry = 1.5 + Math.random() * (MAP_SIZE - 3);
      let mapX = Math.floor(rx);
      let mapY = Math.floor(ry);

      if (MAP[mapY] && MAP[mapY][mapX] === 0) {
        let distToPlayer = player ? Math.hypot(player.x - rx, player.y - ry) : 10;
        if (distToPlayer > 4.0) {
          this.x = rx;
          this.y = ry;
          validSpawn = true;
        }
      }
    }

    this.slowTimer = 0;
    this.burnTimer = 0;
    this.animTimer = Math.random() * 100;
    this.attackTimer = 0;

    const levelScale = 1.0 + (levelIndex * 0.18);
    let baseSpeed = 0.018;

    if (type === 'crawler') {
      baseSpeed = 0.027; this.maxHp = Math.round(65 * levelScale); this.damage = Math.round(7 * levelScale); this.scale = 0.65;
    } else if (type === 'brute') {
      baseSpeed = 0.011; this.maxHp = Math.round(260 * levelScale); this.damage = Math.round(18 * levelScale); this.scale = 1.35;
    } else if (type === 'ghoul') {
      baseSpeed = 0.024; this.maxHp = Math.round(120 * levelScale); this.damage = Math.round(12 * levelScale); this.scale = 0.95;
    } else if (type === 'spitter') {
      baseSpeed = 0.019; this.maxHp = Math.round(140 * levelScale); this.damage = Math.round(14 * levelScale); this.scale = 1.05;
    } else if (type === 'wight') {
      baseSpeed = 0.022; this.maxHp = Math.round(170 * levelScale); this.damage = Math.round(16 * levelScale); this.scale = 1.1;
    } else if (type === 'golem') {
      baseSpeed = 0.010; this.maxHp = Math.round(380 * levelScale); this.damage = Math.round(24 * levelScale); this.scale = 1.45;
    } else if (type === 'lurker') {
      baseSpeed = 0.029; this.maxHp = Math.round(160 * levelScale); this.damage = Math.round(19 * levelScale); this.scale = 0.85;
    } else if (type === 'stalker') {
      baseSpeed = 0.026; this.maxHp = Math.round(220 * levelScale); this.damage = Math.round(22 * levelScale); this.scale = 1.15;
    } else if (type === 'overlord') {
      baseSpeed = 0.014; this.maxHp = 950; this.damage = 38; this.scale = 1.7;
    } else if (type === 'boss_abomination') {
      baseSpeed = 0.016; this.maxHp = 450; this.damage = 25; this.scale = 1.5;
    } else if (type === 'boss_mother') {
      baseSpeed = 0.017; this.maxHp = 600; this.damage = 22; this.scale = 1.55;
    } else if (type === 'boss_leviathan') {
      baseSpeed = 0.022; this.maxHp = 800; this.damage = 30; this.scale = 1.6;
    } else if (type === 'boss_executioner') {
      baseSpeed = 0.018; this.maxHp = 1050; this.damage = 35; this.scale = 1.65;
    } else if (type === 'mega_behemoth') {
      baseSpeed = 0.013; this.maxHp = 2200; this.damage = 45; this.scale = 2.0;
    } else if (type === 'boss_biotitan') {
      baseSpeed = 0.015; this.maxHp = 1350; this.damage = 38; this.scale = 1.7;
    } else if (type === 'boss_frostlord') {
      baseSpeed = 0.019; this.maxHp = 1600; this.damage = 42; this.scale = 1.75;
    } else if (type === 'boss_phantom') {
      baseSpeed = 0.025; this.maxHp = 1850; this.damage = 46; this.scale = 1.7;
    } else if (type === 'boss_juggernaut') {
      baseSpeed = 0.017; this.maxHp = 2200; this.damage = 52; this.scale = 1.85;
    } else if (type === 'mega_necrotitan') {
      baseSpeed = 0.014; this.maxHp = 4000; this.damage = 65; this.scale = 2.2;
    } else {
      baseSpeed = 0.018; this.maxHp = Math.round(110 * levelScale); this.damage = Math.round(9 * levelScale); this.scale = 1.0;
    }

    this.hp = this.maxHp;
    this.speed = baseSpeed * zombieSpeedMultiplier;
  }

  update() {
    this.animTimer += 0.15;
    this.attackTimer++;

    if (this.burnTimer > 0) {
      if (this.burnTimer % 20 === 0) this.hp -= 4;
      this.burnTimer--;
    }

    let effectiveSpeed = this.speed;
    if (this.slowTimer > 0) {
      effectiveSpeed *= 0.25;
      this.slowTimer--;
    }

    const angle = Math.atan2(player.y - this.y, player.x - this.x);

    if (this.isBoss && this.attackTimer % 110 === 0) {
      if (this.type === 'mega_behemoth' || this.type === 'boss_biotitan') {
        enemyProjectiles.push(new ProjectileFPS(this.x, this.y, angle, 0.14, 25, 'toxic', '#70e000', true));
      } else if (this.type === 'boss_frostlord') {
        enemyProjectiles.push(new ProjectileFPS(this.x, this.y, angle, 0.16, 28, 'frost', '#90e0ef', true));
      } else if (this.type === 'boss_juggernaut') {
        enemyProjectiles.push(new ProjectileFPS(this.x, this.y, angle, 0.15, 35, 'fire', '#ff5400', true));
      } else if (this.type === 'mega_necrotitan') {
        enemyProjectiles.push(new ProjectileFPS(this.x, this.y, angle - 0.25, 0.16, 40, 'void', '#7209b7', true));
        enemyProjectiles.push(new ProjectileFPS(this.x, this.y, angle, 0.16, 40, 'void', '#7209b7', true));
        enemyProjectiles.push(new ProjectileFPS(this.x, this.y, angle + 0.25, 0.16, 40, 'void', '#7209b7', true));
      } else if (this.type === 'boss_mother' && zombies.length < 12) {
        zombies.push(new ZombieFPS('crawler', this.levelIndex, false));
      } else if (this.type === 'boss_phantom') {
        this.x = 2.0 + Math.random() * (MAP_SIZE - 4);
        this.y = 2.0 + Math.random() * (MAP_SIZE - 4);
      }
    }

    let stepX = Math.cos(angle) * effectiveSpeed;
    let stepY = Math.sin(angle) * effectiveSpeed;

    const margin = 0.35;
    let canMoveX = MAP[Math.floor(this.y)][Math.floor(this.x + stepX + Math.sign(stepX) * margin)] === 0;
    let canMoveY = MAP[Math.floor(this.y + stepY + Math.sign(stepY) * margin)][Math.floor(this.x)] === 0;

    if (canMoveX) this.x += stepX;
    if (canMoveY) this.y += stepY;

    if (!canMoveX && canMoveY) {
      this.y += Math.sign(stepY || 1) * effectiveSpeed * 0.8;
    } else if (!canMoveY && canMoveX) {
      this.x += Math.sign(stepX || 1) * effectiveSpeed * 0.8;
    }

    const dist = Math.hypot(player.x - this.x, player.y - this.y);
    if (dist < 0.65) {
      if (player.shieldTimer <= 0) {
        player.hp -= this.damage * 0.025;
      }
    }
  }

  draw3DForm(screenX, screenY, width, height, brightness) {
    ctx.save();
    ctx.translate(screenX, screenY);

    const isBurning = this.burnTimer > 0;
    const isFrozen = this.slowTimer > 0;
    const t = this.type;
    const walkBob = Math.sin(this.animTimer * 2) * (height * 0.04);
    const limbSwing = Math.sin(this.animTimer * 2);

    const w = width;
    const h = height;

    if (t === 'crawler' || t === 'boss_mother') {
      ctx.fillStyle = isBurning ? '#e76f51' : (isFrozen ? '#90e0ef' : (t === 'boss_mother' ? '#7b2cbf' : '#2b580c'));
      ctx.beginPath();
      ctx.ellipse(0, h * 0.42 + walkBob, w * 0.35, h * 0.18, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = isBurning ? '#ffb703' : (isFrozen ? '#caf0f8' : (t === 'boss_mother' ? '#e0aaff' : '#3f681c'));
      ctx.beginPath();
      ctx.arc(0, h * 0.48 + walkBob, w * 0.18, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = isBurning ? '#ff0033' : '#aacc00';
      ctx.beginPath();
      ctx.arc(-w * 0.09, h * 0.46 + walkBob, 2.5, 0, Math.PI * 2);
      ctx.arc(w * 0.09, h * 0.46 + walkBob, 2.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = isBurning ? '#ff5400' : '#1b3b06';
      ctx.lineWidth = Math.max(2, w * 0.08);
      ctx.beginPath();
      ctx.moveTo(-w * 0.2, h * 0.42 + walkBob); ctx.lineTo(-w * 0.55, h * 0.25); ctx.lineTo(-w * 0.65, h * 0.85 + limbSwing * 6);
      ctx.moveTo(w * 0.2, h * 0.42 + walkBob); ctx.lineTo(w * 0.55, h * 0.25); ctx.lineTo(w * 0.65, h * 0.85 - limbSwing * 6);
      ctx.stroke();

    } else if (t === 'mega_behemoth' || t === 'boss_biotitan' || t === 'spitter') {
      ctx.fillStyle = isBurning ? '#ff7b00' : (isFrozen ? '#caf0f8' : (t === 'mega_behemoth' ? '#1b4332' : '#38b000'));
      ctx.beginPath();
      ctx.arc(0, h * 0.42 + walkBob, w * 0.36, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ccff33';
      const boilPulse = Math.sin(Date.now() / 100) * 2;
      ctx.beginPath();
      ctx.arc(-w * 0.15, h * 0.35 + walkBob, 6 + boilPulse, 0, Math.PI * 2);
      ctx.arc(w * 0.15, h * 0.45 + walkBob, 7 + boilPulse, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#007200';
      ctx.beginPath();
      ctx.arc(0, h * 0.14 + walkBob, w * 0.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#70e000';
      ctx.beginPath();
      ctx.arc(0, h * 0.18 + walkBob, w * 0.14, 0, Math.PI);
      ctx.fill();

    } else if (t === 'mega_necrotitan' || t === 'overlord') {
      ctx.fillStyle = isBurning ? '#ff0054' : '#240046';
      ctx.fillRect(-w * 0.4, h * 0.16 + walkBob, w * 0.8, h * 0.46);

      ctx.fillStyle = '#ffd166';
      ctx.fillRect(-w * 0.4, h * 0.16 + walkBob, w * 0.8, 6);

      const corePulse = Math.sin(Date.now() / 80) * 3;
      const coreGlow = ctx.createRadialGradient(0, h * 0.36 + walkBob, 2, 0, h * 0.36 + walkBob, 16 + corePulse);
      coreGlow.addColorStop(0, '#ffffff');
      coreGlow.addColorStop(0.4, '#e63946');
      coreGlow.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = coreGlow;
      ctx.beginPath();
      ctx.arc(0, h * 0.36 + walkBob, 16 + corePulse, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#e9ecef';
      ctx.beginPath();
      ctx.arc(0, h * 0.06 + walkBob, w * 0.24, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = '#ffd166';
      ctx.lineWidth = 5;
      ctx.beginPath();
      ctx.moveTo(-w * 0.16, h * 0.02 + walkBob); ctx.quadraticCurveTo(-w * 0.5, -h * 0.18 + walkBob, -w * 0.35, -h * 0.35 + walkBob);
      ctx.moveTo(w * 0.16, h * 0.02 + walkBob); ctx.quadraticCurveTo(w * 0.5, -h * 0.18 + walkBob, w * 0.35, -h * 0.35 + walkBob);
      ctx.stroke();

      ctx.fillStyle = '#ffd166';
      ctx.beginPath();
      ctx.arc(-w * 0.09, h * 0.05 + walkBob, 4.5, 0, Math.PI * 2);
      ctx.arc(w * 0.09, h * 0.05 + walkBob, 4.5, 0, Math.PI * 2);
      ctx.fill();

    } else {
      ctx.fillStyle = isBurning ? '#ff5400' : (isFrozen ? '#90e0ef' : (this.isBoss ? '#6a040f' : '#40916c'));
      ctx.fillRect(-w * 0.28, h * 0.18 + walkBob, w * 0.56, h * 0.44);

      ctx.fillStyle = '#1b263b';
      const legW = w * 0.22;
      ctx.fillRect(-w * 0.26, h * 0.58 + walkBob - limbSwing * 6, legW, h * 0.4);
      ctx.fillRect(w * 0.04, h * 0.58 + walkBob + limbSwing * 6, legW, h * 0.4);

      ctx.fillStyle = this.isBoss ? '#e85d04' : '#52b788';
      ctx.beginPath();
      ctx.arc(0, h * 0.1 + walkBob, w * 0.2, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ff0033';
      ctx.beginPath();
      ctx.arc(-w * 0.08, h * 0.09 + walkBob, 3, 0, Math.PI * 2);
      ctx.arc(w * 0.08, h * 0.09 + walkBob, 3, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.translate(-w * 0.32, h * 0.22 + walkBob);
      ctx.rotate(0.2 + limbSwing * 0.15);
      ctx.fillStyle = '#111';
      ctx.fillRect(0, 0, w * 0.18, h * 0.36);
      ctx.restore();

      ctx.save();
      ctx.translate(w * 0.18, h * 0.22 + walkBob);
      ctx.rotate(-0.2 - limbSwing * 0.15);
      ctx.fillStyle = '#111';
      ctx.fillRect(0, 0, w * 0.18, h * 0.36);
      ctx.restore();
    }

    ctx.restore();
  }
}

function renderMinimap() {
  const size = mapCanvas.width;
  const center = size / 2;
  const scale = 11;
  const viewRadius = 4.0;

  mapCtx.clearRect(0, 0, size, size);

  mapCtx.save();
  mapCtx.beginPath();
  mapCtx.arc(center, center, center - 2, 0, Math.PI * 2);
  mapCtx.clip();

  mapCtx.fillStyle = '#1b2219';
  mapCtx.fillRect(0, 0, size, size);

  const minX = Math.max(0, Math.floor(player.x - viewRadius));
  const maxX = Math.min(MAP_SIZE - 1, Math.floor(player.x + viewRadius));
  const minY = Math.max(0, Math.floor(player.y - viewRadius));
  const maxY = Math.min(MAP_SIZE - 1, Math.floor(player.y + viewRadius));

  for (let y = minY; y <= maxY; y++) {
    for (let x = minX; x <= maxX; x++) {
      if (MAP[y][x] === 1) {
        const screenX = center + (x - player.x) * scale;
        const screenY = center + (y - player.y) * scale;
        mapCtx.fillStyle = '#3a4454';
        mapCtx.fillRect(screenX, screenY, scale, scale);
        mapCtx.strokeStyle = '#222938';
        mapCtx.lineWidth = 1;
        mapCtx.strokeRect(screenX, screenY, scale, scale);
      }
    }
  }

  drops.forEach(d => {
    const dist = Math.hypot(d.x - player.x, d.y - player.y);
    if (dist <= viewRadius) {
      const dx = center + (d.x - player.x) * scale;
      const dy = center + (d.y - player.y) * scale;
      mapCtx.fillStyle = d.dropType === 'health' ? '#ff3366' : (d.dropType === 'mana' ? '#00b4d8' : '#ffd166');
      mapCtx.beginPath();
      mapCtx.arc(dx, dy, 2.5, 0, Math.PI * 2);
      mapCtx.fill();
    }
  });

  projectiles.forEach(p => {
    const dist = Math.hypot(p.x - player.x, p.y - player.y);
    if (dist <= viewRadius) {
      const px = center + (p.x - player.x) * scale;
      const py = center + (p.y - player.y) * scale;
      mapCtx.fillStyle = p.color;
      mapCtx.beginPath();
      mapCtx.arc(px, py, 2, 0, Math.PI * 2);
      mapCtx.fill();
    }
  });

  enemyProjectiles.forEach(p => {
    const dist = Math.hypot(p.x - player.x, p.y - player.y);
    if (dist <= viewRadius) {
      const px = center + (p.x - player.x) * scale;
      const py = center + (p.y - player.y) * scale;
      mapCtx.fillStyle = '#ff0054';
      mapCtx.beginPath();
      mapCtx.arc(px, py, 2.5, 0, Math.PI * 2);
      mapCtx.fill();
    }
  });

  zombies.forEach(z => {
    const dist = Math.hypot(z.x - player.x, z.y - player.y);
    if (dist <= viewRadius) {
      const zx = center + (z.x - player.x) * scale;
      const zy = center + (z.y - player.y) * scale;
      mapCtx.fillStyle = z.isBoss ? '#ff0054' : (z.burnTimer > 0 ? '#ff5400' : '#52b788');
      mapCtx.beginPath();
      mapCtx.arc(zx, zy, z.isBoss ? 5 : 3, 0, Math.PI * 2);
      mapCtx.fill();
      mapCtx.strokeStyle = '#000';
      mapCtx.lineWidth = 1;
      mapCtx.stroke();
    }
  });

  const fov = Math.PI / 3;
  mapCtx.fillStyle = 'rgba(255, 255, 255, 0.15)';
  mapCtx.beginPath();
  mapCtx.moveTo(center, center);
  mapCtx.arc(center, center, scale * 3.2, player.angle - fov / 2, player.angle + fov / 2);
  mapCtx.closePath();
  mapCtx.fill();

  mapCtx.fillStyle = '#f1faee';
  mapCtx.beginPath();
  mapCtx.arc(center, center, 3.5, 0, Math.PI * 2);
  mapCtx.fill();

  mapCtx.strokeStyle = '#ffb703';
  mapCtx.lineWidth = 1.5;
  mapCtx.beginPath();
  mapCtx.moveTo(center, center);
  mapCtx.lineTo(center + Math.cos(player.angle) * 10, center + Math.sin(player.angle) * 10);
  mapCtx.stroke();

  mapCtx.restore();
}

function render3D() {
  const fov = Math.PI / 3;
  const numRays = canvas.width;
  const halfFov = fov / 2;
  const halfHeight = canvas.height / 2;
  const curTerrain = LEVELS[currentLevelIndex].terrain;

  const ceilGrad = ctx.createLinearGradient(0, 0, 0, halfHeight);
  ceilGrad.addColorStop(0, curTerrain.ceil);
  ceilGrad.addColorStop(1, '#1b222c');
  ctx.fillStyle = ceilGrad;
  ctx.fillRect(0, 0, canvas.width, halfHeight);

  const floorGrad = ctx.createLinearGradient(0, halfHeight, 0, canvas.height);
  floorGrad.addColorStop(0, curTerrain.floor[0]);
  floorGrad.addColorStop(0.5, curTerrain.floor[1]);
  floorGrad.addColorStop(1, curTerrain.floor[2]);
  ctx.fillStyle = floorGrad;
  ctx.fillRect(0, halfHeight, canvas.width, halfHeight);

  for (let i = 0; i < numRays; i++) {
    const rayAngle = (player.angle - halfFov) + (i / numRays) * fov;
    let distanceToWall = 0;
    let hitWall = false;
    let hitX = 0, hitY = 0;
    let isVertical = false;

    const cos = Math.cos(rayAngle);
    const sin = Math.sin(rayAngle);

    while (!hitWall && distanceToWall < 16) {
      distanceToWall += 0.03;
      hitX = player.x + cos * distanceToWall;
      hitY = player.y + sin * distanceToWall;

      const checkX = Math.floor(hitX);
      const checkY = Math.floor(hitY);

      if (checkX < 0 || checkX >= MAP_SIZE || checkY < 0 || checkY >= MAP_SIZE) {
        hitWall = true;
        distanceToWall = 16;
      } else if (MAP[checkY][checkX] === 1) {
        hitWall = true;
        const blockX = hitX - checkX;
        if (blockX < 0.05 || blockX > 0.95) isVertical = true;
      }
    }

    const correctedDist = distanceToWall * Math.cos(rayAngle - player.angle);
    zBuffer[i] = correctedDist;

    const wallHeight = (canvas.height / correctedDist);
    const ceiling = halfHeight - wallHeight / 2;

    let wallU = isVertical ? (hitY % 1) : (hitX % 1);
    if (wallU < 0) wallU += 1;
    const texX = Math.floor(wallU * TEX_SIZE);

    ctx.drawImage(
      wallTextureCanvas,
      texX, 0, 1, TEX_SIZE,
      i, ceiling, 1, wallHeight
    );

    const fog = Math.min(1, correctedDist / 12);
    const sideShadow = isVertical ? 0.2 : 0.0;
    ctx.fillStyle = `rgba(5, 7, 10, ${Math.min(0.95, fog * 0.85 + sideShadow)})`;
    ctx.fillRect(i, ceiling, 1, wallHeight);
  }

  const sprites = [];

  zombies.forEach(z => {
    sprites.push({ type: 'zombie', obj: z, dist: Math.hypot(player.x - z.x, player.y - z.y) });
  });
  drops.forEach(d => {
    sprites.push({ type: 'drop', obj: d, dist: Math.hypot(player.x - d.x, player.y - d.y) });
  });
  projectiles.forEach(p => {
    sprites.push({ type: 'proj', obj: p, dist: Math.hypot(player.x - p.x, player.y - p.y) });
  });
  enemyProjectiles.forEach(p => {
    sprites.push({ type: 'enemyProj', obj: p, dist: Math.hypot(player.x - p.x, player.y - p.y) });
  });

  sprites.sort((a, b) => b.dist - a.dist);

  sprites.forEach(s => {
    if (s.dist < 0.2 || s.dist > 15) return;

    let spriteAngle = Math.atan2(s.obj.y - player.y, s.obj.x - player.x) - player.angle;
    while (spriteAngle < -Math.PI) spriteAngle += Math.PI * 2;
    while (spriteAngle > Math.PI) spriteAngle -= Math.PI * 2;

    if (Math.abs(spriteAngle) > halfFov + 0.3) return;

    const screenX = (canvas.width / 2) + Math.tan(spriteAngle) * (canvas.width / 2) / Math.tan(halfFov);
    const spriteHeight = (canvas.height / s.dist) * (s.obj.scale || 1.0);
    const spriteWidth = spriteHeight * 0.65;
    const screenY = (canvas.height / 2) - spriteHeight / 2;

    const xIndex = Math.floor(screenX);
    if (xIndex >= 0 && xIndex < canvas.width && zBuffer[xIndex] > s.dist) {
      if (s.type === 'zombie') {
        const z = s.obj;
        const brightness = Math.max(0.15, 1 - s.dist / 14);
        z.draw3DForm(screenX, screenY, spriteWidth, spriteHeight, brightness);

        const info = ZOMBIE_INFO[z.type] || { name: "Zombie", color: "#52b788" };
        const textFontSize = Math.max(9, Math.min(14, Math.floor(110 / s.dist)));
        ctx.font = `bold ${textFontSize}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.fillStyle = info.color;
        ctx.shadowColor = '#000';
        ctx.shadowBlur = 4;
        
        const nameY = screenY - (z.isBoss ? 16 : 22);
        ctx.fillText(info.name, screenX, nameY);
        ctx.shadowBlur = 0;

        if (!z.isBoss) {
          const barW = spriteWidth;
          const barH = 4;
          ctx.fillStyle = 'rgba(0,0,0,0.6)';
          ctx.fillRect(screenX - barW / 2, screenY - 14, barW, barH);
          ctx.fillStyle = '#52b788';
          ctx.fillRect(screenX - barW / 2, screenY - 14, barW * (Math.max(0, z.hp) / z.maxHp), barH);
        }
      } else if (s.type === 'drop') {
        s.obj.drawGraphic(screenX, screenY + spriteHeight * 0.6, spriteHeight * 0.35, s.dist);
      } else if (s.type === 'proj' || s.type === 'enemyProj') {
        ctx.fillStyle = s.obj.color;
        ctx.beginPath();
        ctx.arc(screenX, canvas.height / 2, Math.max(3, 14 / s.dist), 0, Math.PI * 2);
        ctx.fill();
      }
    }
  });

  renderFPWeapon();
}

