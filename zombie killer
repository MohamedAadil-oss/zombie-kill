    const handY = canvas.height - 15 - swing * 45 + breathBob;
    ctx.translate(handX, handY);
    ctx.rotate(-0.18 + (player.swingAnim * 0.5));

    const staffGrad = ctx.createLinearGradient(-10, -180, 10, 40);
    staffGrad.addColorStop(0, '#480ca8');
    staffGrad.addColorStop(0.5, '#240046');
    staffGrad.addColorStop(1, '#10002b');
    ctx.fillStyle = staffGrad;
    ctx.fillRect(-8, -170, 16, 220);

    ctx.fillStyle = isBuffed ? '#ff0054' : '#7209b7';
    ctx.beginPath();
    ctx.moveTo(-22, -170); ctx.quadraticCurveTo(-32, -210, -14, -235); ctx.lineTo(-6, -180);
    ctx.moveTo(22, -170); ctx.quadraticCurveTo(32, -210, 14, -235); ctx.lineTo(6, -180);
    ctx.fill();

    const orbY = -215;
    const orbGlow = ctx.createRadialGradient(0, orbY, 2, 0, orbY, isBuffed ? 34 : 24);
    orbGlow.addColorStop(0, '#ffffff');
    orbGlow.addColorStop(0.35, isBuffed ? '#ff0054' : '#4cc9f0');
    orbGlow.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = orbGlow;
    ctx.beginPath();
    ctx.arc(0, orbY, isBuffed ? 34 : 24, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#3c096c';
    ctx.beginPath();
    ctx.roundRect(-24, 18, 48, 44, 10);
    ctx.fill();

  } else if (player.heroClass === 'archer') {
    const handX = canvas.width * 0.65 + breathSway;
    const handY = canvas.height - 20 - swing * 35 + breathBob;
    ctx.translate(handX, handY);

    ctx.strokeStyle = isBuffed ? '#ffb703' : '#6f1d1b';
    ctx.lineWidth = 9;
    ctx.beginPath();
    ctx.moveTo(0, 40);
    ctx.quadraticCurveTo(55, -60, 0, -165);
    ctx.stroke();

    const drawPull = isBuffed ? -22 : -12;
    ctx.strokeStyle = 'rgba(255,255,255,0.85)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, 40); ctx.lineTo(drawPull, -60); ctx.lineTo(0, -165);
    ctx.stroke();

    ctx.fillStyle = '#e9c46a';
    ctx.fillRect(drawPull, -120, 6, 120);

    let tipColor = arrowType === 'fire' ? '#e76f51' : (arrowType === 'ice' ? '#48cae4' : '#ced4da');
    ctx.fillStyle = tipColor;
    ctx.beginPath();
    ctx.moveTo(drawPull - 5, -120); ctx.lineTo(drawPull + 3, -150); ctx.lineTo(drawPull + 11, -120);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#582f0e';
    ctx.beginPath();
    ctx.roundRect(14, -80, 20, 38, 6);
    ctx.fill();
  }

  ctx.restore();
}

function spawnLevelZombie() {
  const currentCfg = LEVELS[currentLevelIndex];
  const typeRoll = currentCfg.types[Math.floor(Math.random() * currentCfg.types.length)];
  return new ZombieFPS(typeRoll, currentLevelIndex, false);
}

function spawnLevelBoss() {
  bossSpawned = true;
  const currentCfg = LEVELS[currentLevelIndex];
  currentBoss = new ZombieFPS(currentCfg.bossType, currentLevelIndex, true);
  zombies.push(currentBoss);

  const bossHud = document.getElementById('boss-hud');
  bossHud.style.display = 'block';
  document.getElementById('boss-name').innerText = `BOSS: ${currentCfg.bossName}`;
  document.getElementById('goal-status').innerHTML = `<span style="color:#ff0054; font-weight:bold;">DEFEAT BOSS!</span>`;
}

function loadLevel(levelIdx) {
  currentLevelIndex = levelIdx;
  levelKills = 0;
  bossSpawned = false;
  currentBoss = null;
  document.getElementById('boss-hud').style.display = 'none';

  updateWallTexture(LEVELS[currentLevelIndex].terrain);
  document.getElementById('level-badge').innerText = `LEVEL ${levelIdx + 1}: ${LEVELS[levelIdx].name}`;
  
  zombies = [];
  drops = [];
  projectiles = [];
  enemyProjectiles = [];
  spawnTimer = 0;

  for (let i = 0; i < 6; i++) {
    zombies.push(spawnLevelZombie());
  }
}

function startGame() {
  document.getElementById('char-select-screen').style.display = 'none';
  document.getElementById('game-over-screen').style.display = 'none';
  document.getElementById('level-clear-screen').style.display = 'none';
  document.getElementById('victory-screen').style.display = 'none';
  
  const isArcher = chosenClass === 'archer';
  document.getElementById('arrow-selector').style.display = isArcher ? 'flex' : 'none';
  
  const mpContainer = document.getElementById('mp-container');
  mpContainer.style.display = chosenClass === 'wizard' ? 'block' : 'none';

  document.getElementById('mobile-ui').style.display = deviceMode === 'mobile' ? 'block' : 'none';
  document.getElementById('click-prompt').style.display = deviceMode === 'desktop' ? 'block' : 'none';
  document.getElementById('exit-btn').style.display = 'block';

  player = new PlayerFPS(chosenClass);
  totalKills = 0;
  loadLevel(0);

  gameState = 'playing';
  if (deviceMode === 'desktop') canvas.requestPointerLock();
}

function nextLevel() {
  document.getElementById('level-clear-screen').style.display = 'none';
  if (currentLevelIndex + 1 < LEVELS.length) {
    loadLevel(currentLevelIndex + 1);
    player.hp = Math.min(player.maxHp, player.hp + 100);
    gameState = 'playing';
    if (deviceMode === 'desktop') canvas.requestPointerLock();
  } else {
    gameState = 'victory';
    if (document.exitPointerLock) document.exitPointerLock();
    document.getElementById('victory-screen').style.display = 'flex';
  }
}

function updateHUD() {
  const hpFill = document.getElementById('hp-fill');
  const hpLabel = document.getElementById('hp-label');
  const hpPct = Math.max(0, (player.hp / player.maxHp) * 100);
  hpFill.style.width = hpPct + '%';
  hpLabel.innerText = `HP: ${Math.ceil(Math.max(0, player.hp))} / ${player.maxHp}`;

  if (player.heroClass === 'wizard') {
    const mpFill = document.getElementById('mp-fill');
    const mpLabel = document.getElementById('mp-label');
    const mpPct = Math.max(0, (player.mp / player.maxMp) * 100);
    mpFill.style.width = hpPct + '%';
    mpLabel.innerText = `MP: ${Math.ceil(player.mp)} / ${player.maxMp}`;
  }

  const curQuota = LEVELS[currentLevelIndex].quota;
  if (!bossSpawned) {
    document.getElementById('goal-status').innerHTML = `Minions: <span id="quota-display" style="color:#ffd166">${levelKills} / ${curQuota}</span>`;
  }
  document.getElementById('kill-display').innerText = `${totalKills}`;

  if (bossSpawned && currentBoss && currentBoss.hp > 0) {
    const bossFill = document.getElementById('boss-bar-fill');
    const bossPct = Math.max(0, (currentBoss.hp / currentBoss.maxHp) * 100);
    bossFill.style.width = bossPct + '%';
  }
}

function loop() {
  if (gameState === 'playing') {
    spawnTimer++;
    const currentInterval = Math.max(30, baseSpawnInterval - Math.floor(currentLevelIndex * 3));
    if (spawnTimer % currentInterval === 0 && zombies.length < 16 && !bossSpawned) {
      zombies.push(spawnLevelZombie());
    }

    player.update();

    for (let i = drops.length - 1; i >= 0; i--) {
      drops[i].update();
      if (drops[i].life <= 0) drops.splice(i, 1);
    }

    for (let i = projectiles.length - 1; i >= 0; i--) {
      const p = projectiles[i];
      p.update();

      for (let j = zombies.length - 1; j >= 0; j--) {
        const z = zombies[j];
        if (Math.hypot(z.x - p.x, z.y - p.y) < 0.6) {
          z.hp -= p.damage;
          if (p.type === 'fire') z.burnTimer = 80;
          if (p.type === 'ice') z.slowTimer = 100;
          if (p.type !== 'bigMagic') p.dead = true;
          break;
        }
      }

      if (p.dead) projectiles.splice(i, 1);
    }

    for (let i = enemyProjectiles.length - 1; i >= 0; i--) {
      const ep = enemyProjectiles[i];
      ep.update();
      if (ep.dead) enemyProjectiles.splice(i, 1);
    }

    for (let i = zombies.length - 1; i >= 0; i--) {
      const z = zombies[i];
      z.update();
      if (z.hp <= 0) {
        totalKills++;

        const roll = Math.random();
        if (roll < 0.14) drops.push(new DropFPS(z.x, z.y, 'health', chosenClass));
        else if (roll < 0.22) drops.push(new DropFPS(z.x, z.y, 'mana', chosenClass));
        else if (roll < 0.28) drops.push(new DropFPS(z.x, z.y, 'speed', chosenClass));
        else if (roll < 0.34) drops.push(new DropFPS(z.x, z.y, 'shield', chosenClass));
        else if (roll < 0.39) drops.push(new DropFPS(z.x, z.y, 'freeze', chosenClass));
        else if (roll < 0.43) drops.push(new DropFPS(z.x, z.y, 'nuke', chosenClass));
        else if (roll < 0.50) drops.push(new DropFPS(z.x, z.y, 'buff', chosenClass));

        if (!z.isBoss) {
          levelKills++;
          if (levelKills >= LEVELS[currentLevelIndex].quota && !bossSpawned) {
            spawnLevelBoss();
          }
        } else {
          document.getElementById('boss-hud').style.display = 'none';
          gameState = 'levelclear';
          if (document.exitPointerLock) document.exitPointerLock();
          document.getElementById('level-clear-desc').innerText = `You defeated ${LEVELS[currentLevelIndex].bossName} and purified Level ${currentLevelIndex + 1}!`;
          document.getElementById('level-clear-screen').style.display = 'flex';
          break;
        }

        zombies.splice(i, 1);
      }
    }

    render3D();
    renderMinimap();
    updateHUD();

    if (player.hp <= 0) {
      gameState = 'gameover';
      if (document.exitPointerLock) document.exitPointerLock();
      document.getElementById('survival-stats').innerText = `You made it to Level ${currentLevelIndex + 1} (${LEVELS[currentLevelIndex].name}) with ${totalKills} kills before falling.`;
      document.getElementById('game-over-screen').style.display = 'flex';
      document.getElementById('arrow-selector').style.display = 'none';
      document.getElementById('buff-box').innerHTML = '';
      document.getElementById('mobile-ui').style.display = 'none';
      document.getElementById('exit-btn').style.display = 'none';
      document.getElementById('boss-hud').style.display = 'none';
    }
  }

  requestAnimationFrame(loop);
}

loop();
</script>
