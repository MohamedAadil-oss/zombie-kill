  .device-card .title { font-weight: bold; font-size: 1rem; color: #f1faee; }

  .card-container { display: flex; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; justify-content: center; }
  .char-card { background: #161922; border: 2px solid #2d3345; border-radius: 8px; width: 160px; padding: 10px; cursor: pointer; transition: all 0.2s; text-align: left; }
